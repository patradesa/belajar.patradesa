{
  "name": "patradesa-belajar",
  "private": true,
  "version": "0.1.0",
  "description": "PatraDesa Belajar — LMS ringan mobile-first untuk perangkat desa (Cloudflare Workers + Hono + D1 + R2 + React).",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build -w apps/web && npm run db:migrate:local && wrangler dev",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "typecheck": "tsc -p packages/shared && tsc -p apps/api && tsc -p apps/web && tsc -p tests",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project web",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "guides": "playwright test -c playwright.guide.config.ts",
    "budget": "node scripts/check-budget.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "seed:dev": "node scripts/seed-dev.mjs",
    "e2e:server": "node scripts/e2e-server.mjs",
    "lokal": "node scripts/lokal.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run budget"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@cloudflare/workers-types": "5.20261125.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.7",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "lighthouse": "13.6.0",
    "miniflare": "4.20260730.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.168.0"
  }
}
